# Local development environment template (Phase 9.5)
# =====================================================
# Copy to `.env` and fill in real values. NEVER commit `.env` or any
# file containing real secret values (`.env*` is gitignored).
#
# Google OAuth: create/select a project in the Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (type "Web
# application"). Authorized redirect URI for local dev:
#   http://localhost:3000/api/auth/callback/google
# (The production/Railway redirect URI is configured separately in the
# deployment environment — see docs/phase95-oauth-forensics.md.)
#
# NEXTAUTH_SECRET: generate a strong local value, e.g.
#   openssl rand -base64 32

# Local SQLite database (Prisma)
DATABASE_URL=file:./db/custom.db

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth (v4)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Ops events mini-service (optional, local only)
# OPS_EVENTS_URL=
