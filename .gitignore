local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# Skills directory
/skills/

# SQLite database (regenerated via prisma db push)
db/*.db
db/*.db-journal
db/backups/

# Prisma migrations (this project uses db push, not migrate)
/prisma/migrations/

