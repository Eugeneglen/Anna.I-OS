---
/**
 * Anna.I Marketing — Header
 * ─────────────────────────────────────────────────────────────
 * Sticky global nav with persistent Register Now CTA button.
 * Wordmark "Anna.I" (sage-600, bold). No logo icon.
 * Nav: Home / Partners / Services (anchor) / FAQ / Contact / [Register Now]
 * Register Now → /login (routes to product app on port 3000).
 *
 * Mobile: nav links in a horizontal scroll row with a right-edge
 * fade gradient to indicate more items. Scroll-snap for smooth UX.
 * Touch targets enlarged to meet WCAG 44px minimum.
 */
---

<header
  style="position: sticky; top: 0; z-index: 50; background: rgba(244, 247, 245, 0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(32,49,50,0.08);"
>
  <nav class="container-content" style="display: flex; align-items: center; justify-content: space-between; height: 4rem;">
    {/* Wordmark */}
    <a href="/" style="font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em; color: var(--sage-600); font-family: 'Manrope', sans-serif;">
      Anna.I
    </a>

    {/* Desktop nav */}
    <div class="hidden lg:block" style="display: none;">
      <div style="display: flex; align-items: center; gap: 2rem;">
        <a href="/" style="font-size: 0.9rem; font-weight: 500; color: var(--slate); transition: color 0.2s;" onmouseover="this.style.color='var(--sage-600)'" onmouseout="this.style.color='var(--slate)'">Home</a>
        <a href="/partners" style="font-size: 0.9rem; font-weight: 500; color: var(--slate); transition: color 0.2s;" onmouseover="this.style.color='var(--sage-600)'" onmouseout="this.style.color='var(--slate)'">Partners</a>
        <a href="/#services" style="font-size: 0.9rem; font-weight: 500; color: var(--slate); transition: color 0.2s;" onmouseover="this.style.color='var(--sage-600)'" onmouseout="this.style.color='var(--slate)'">Services</a>
        <a href="/faq" style="font-size: 0.9rem; font-weight: 500; color: var(--slate); transition: color 0.2s;" onmouseover="this.style.color='var(--sage-600)'" onmouseout="this.style.color='var(--slate)'">FAQ</a>
        <a href="/contact-us" style="font-size: 0.9rem; font-weight: 500; color: var(--slate); transition: color 0.2s;" onmouseover="this.style.color='var(--sage-600)'" onmouseout="this.style.color='var(--slate)'">Contact</a>
      </div>
    </div>

    {/* CTA button */}
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <a href="/login" class="btn btn-primary" data-cta="header-register" style="padding: 0.7rem 1.25rem; font-size: 0.9rem;">
        Register Now
      </a>
    </div>
  </nav>

  {/* Mobile nav — horizontal scroll with fade indicator */}
  <div class="lg:hidden mobile-nav-scroll" style="display: flex; gap: 0.25rem; padding: 0.25rem 0.75rem 0.75rem; overflow-x: auto; font-size: 0.85rem; -webkit-overflow-scrolling: touch; scroll-snap-type: x proximity; scrollbar-width: none;">
    <a href="/" style="font-weight: 500; color: var(--slate); white-space: nowrap; padding: 0.5rem 0.375rem; scroll-snap-align: start;">Home</a>
    <a href="/partners" style="font-weight: 500; color: var(--slate); white-space: nowrap; padding: 0.5rem 0.375rem; scroll-snap-align: start;">Partners</a>
    <a href="/#services" style="font-weight: 500; color: var(--slate); white-space: nowrap; padding: 0.5rem 0.375rem; scroll-snap-align: start;">Services</a>
    <a href="/faq" style="font-weight: 500; color: var(--slate); white-space: nowrap; padding: 0.5rem 0.375rem; scroll-snap-align: start;">FAQ</a>
    <a href="/contact-us" style="font-weight: 500; color: var(--slate); white-space: nowrap; padding: 0.5rem 0.375rem; scroll-snap-align: start;">Contact</a>
  </div>
</header>

<style>
  @media (min-width: 1024px) {
    header .hidden.lg\:block { display: block !important; }
    header .lg\:hidden { display: none !important; }
  }
  /* Hide scrollbar on mobile nav (keep scroll functionality) */
  .mobile-nav-scroll::-webkit-scrollbar { display: none; }
  /* Right-edge fade gradient to indicate more items when scrollable */
  .mobile-nav-scroll {
    -webkit-mask-image: linear-gradient(to right, black 0%, black 85%, transparent 100%);
    mask-image: linear-gradient(to right, black 0%, black 85%, transparent 100%);
  }
  /* When scrolled to end, remove the fade (JS toggles .scrolled-end) */
  .mobile-nav-scroll.scrolled-end {
    -webkit-mask-image: none;
    mask-image: none;
  }
</style>

<script is:inline>
  // Toggle fade indicator based on scroll position
  (function() {
    var nav = document.querySelector('.mobile-nav-scroll');
    if (!nav) return;
    function updateFade() {
      var maxScroll = nav.scrollWidth - nav.clientWidth;
      if (nav.scrollLeft >= maxScroll - 2) {
        nav.classList.add('scrolled-end');
      } else {
        nav.classList.remove('scrolled-end');
      }
    }
    nav.addEventListener('scroll', updateFade, { passive: true });
    updateFade();
  })();
</script>
