---
/**
 * Anna.I Marketing — Base Layout
 * ─────────────────────────────────────────────────────────────
 * Wraps every page with: <head>, fonts, header, main, footer.
 * Includes the scroll-reveal observer + preview-gateway bridge.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  schema?: object;
}

const {
  title,
  description = 'Anna.I — The operating system for the modern household. Cleaning, laundry, aircon, and handyman services coordinated through one intelligent system in Singapore.',
  schema,
} = Astro.props;

const fullTitle = title.includes('Anna.I') ? title : `${title} — Anna.I`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-default.svg" />

    {/* Fonts — Manrope (body) + JetBrains Mono (labels) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <div class="flex flex-col" style="min-height: 100vh; min-height: 100dvh;">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    {/* Scroll reveal observer — is:inline so it never gets hoisted to an
        external JS file (which would 404 through the preview gateway).
        Adds .js class to <html> FIRST so CSS can hide .reveal elements
        only when JS is available (progressive enhancement). */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        function reveal() {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
          );
          document.querySelectorAll('.reveal').forEach(function (el) {
            observer.observe(el);
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', reveal);
        } else {
          reveal();
        }
      })();
    </script>

    {/* Link-bridge — handles both sandbox preview and production.
        is:inline so it is embedded directly in the HTML and always runs,
        even when the hoisted JS bundle fails to load through the gateway.

        SANDBOX MODE (page loaded via ?XTransformPort=4321):
          Marketing links keep XTransformPort so they stay on port 4321.
          Product-app links (/login, /register, /dashboard) drop it so the
          gateway routes them to port 3000 (the Next.js product app).

        PRODUCTION MODE (no XTransformPort — e.g. Railway deployment):
          Marketing links stay as-is (same domain).
          Product-app links are rewritten to the absolute production product-app
          URL so they don't 404 on the marketing site's domain. */}
    <script is:inline>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var port = params.get('XTransformPort');

        // Product-app paths that route to the Next.js product app
        var productPaths = ['/login', '/register', '/dashboard', '/api/auth', '/api/household'];
        // Production product-app URL (Railway)
        var PRODUCT_APP_URL = 'https://annai-os-production.up.railway.app';

        function isProductPath(href) {
          if (!href) return false;
          for (var i = 0; i < productPaths.length; i++) {
            var p = productPaths[i];
            if (href === p) return true;
            if (href.indexOf(p + '?') === 0) return true;
            if (href.indexOf(p + '/') === 0) return true;
            if (href.indexOf(p + '#') === 0) return true;
          }
          return false;
        }

        function rewriteLink(a) {
          var href = a.getAttribute('href');
          if (!href) return;

          if (port) {
            // ── Sandbox mode (preview gateway) ──
            // Marketing links: preserve XTransformPort so they stay on port 4321.
            // Product links: leave as-is — the gateway routes them to port 3000.
            if (href.charAt(0) !== '/') return;                // external/absolute
            if (href.indexOf('XTransformPort') !== -1) return; // already rewritten
            if (isProductPath(href)) return;                   // product app → gateway handles
            var u = new URL(href, window.location.origin);
            if (!u.searchParams.has('XTransformPort')) {
              u.searchParams.set('XTransformPort', port);
              // Preserve hash (e.g. #services, #how-it-works)
              a.setAttribute('href', u.pathname + u.search + u.hash);
            }
          } else {
            // ── Production mode (Railway, no gateway) ──
            // Product links: rewrite to the production product-app URL so
            // they don't 404 on the marketing site's domain.
            // Marketing links: leave as-is (same domain).
            if (isProductPath(href)) {
              a.setAttribute('href', PRODUCT_APP_URL + href);
            }
          }
        }

        // Rewrite all existing anchor hrefs on load
        document.querySelectorAll('a[href]').forEach(rewriteLink);

        // Also rewrite on click (catches dynamically-added links)
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a');
          if (a) rewriteLink(a);
        });
      })();
    </script>
  </body>
</html>
