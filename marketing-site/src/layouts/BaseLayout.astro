---
/**
 * Anna.I Marketing — Base Layout
 * ─────────────────────────────────────────────────────────────
 * Wraps every page with: <head>, fonts, header, main, footer.
 * Includes the scroll-reveal observer + preview-gateway bridge.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  schema?: object;
}

const {
  title,
  description = 'Anna.I — The operating system for the modern household. Cleaning, laundry, aircon, and handyman services coordinated through one intelligent system in Singapore.',
  schema,
} = Astro.props;

const fullTitle = title.includes('Anna.I') ? title : `${title} — Anna.I`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-default.svg" />

    {/* Fonts — Manrope (body) + JetBrains Mono (labels) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <div class="flex flex-col" style="min-height: 100vh;">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    {/* Scroll reveal observer — is:inline so it never gets hoisted to an
        external JS file (which would 404 through the preview gateway). */}
    <script is:inline>
      (function () {
        function reveal() {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
          );
          document.querySelectorAll('.reveal').forEach(function (el) {
            observer.observe(el);
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', reveal);
        } else {
          reveal();
        }
      })();
    </script>

    {/* Preview-gateway bridge — preserves XTransformPort across navigation.
        is:inline so it is embedded directly in the HTML and always runs,
        even when the hoisted JS bundle fails to load through the gateway.
        When the page is loaded via ?XTransformPort=4321 (sandbox preview),
        internal links to the marketing site keep that param. Links to the
        product app (/login, /register, /dashboard) intentionally drop it
        so they route to port 3000 (the Next.js product app). */}
    <script is:inline>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var port = params.get('XTransformPort');
        if (!port) return;

        // Product-app paths that should NOT carry XTransformPort
        var productPaths = ['/login', '/register', '/dashboard', '/api/auth', '/api/household'];

        function shouldPreserve(href) {
          if (!href) return false;
          for (var i = 0; i < productPaths.length; i++) {
            var p = productPaths[i];
            if (href === p || href.indexOf(p + '?') === 0 || href.indexOf(p + '/') === 0) return false;
          }
          return href.charAt(0) === '/' && href.indexOf('XTransformPort') === -1;
        }

        function rewriteLink(a) {
          var href = a.getAttribute('href');
          if (!shouldPreserve(href)) return;
          var u = new URL(href, window.location.origin);
          if (!u.searchParams.has('XTransformPort')) {
            u.searchParams.set('XTransformPort', port);
            // Preserve hash (e.g. #services, #how-it-works) — without this,
            // anchor links like /#services would lose the hash and jump to top.
            a.setAttribute('href', u.pathname + u.search + u.hash);
          }
        }

        // Rewrite all existing anchor hrefs on load
        document.querySelectorAll('a[href]').forEach(rewriteLink);

        // Also rewrite on click (catches dynamically-added links)
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a');
          if (a) rewriteLink(a);
        });
      })();
    </script>
  </body>
</html>
