---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Contact Us — Anna.I"
  description="Get in touch with the Anna.I team. Questions, partnership inquiries, or feedback — we respond within one business day."
>
  <section class="section">
    <div class="container-content" style="max-width: 48rem;">
      <div class="text-center mb-12 reveal">
        <span class="badge mb-5">Contact</span>
        <h1 class="text-fluid-3xl mb-4 text-balance">Get in touch.</h1>
        <p class="text-fluid-lg text-slate\/70 text-pretty">
          Questions, partnership inquiries, or feedback — we would love to hear from you.
        </p>
      </div>

      <div class="card reveal" style="padding: clamp(2rem, 1.5rem + 2vw, 3rem);">
        <form id="contact-form" style="display: flex; flex-direction: column; gap: 1rem;">
          <div>
            <label for="name" class="font-mono-label text-slate\/50" style="display: block; margin-bottom: 0.5rem;">Name</label>
            <input type="text" id="name" name="name" class="field" required placeholder="Your name" />
          </div>
          <div>
            <label for="email" class="font-mono-label text-slate\/50" style="display: block; margin-bottom: 0.5rem;">Email</label>
            <input type="email" id="email" name="email" class="field" required placeholder="you@example.com" />
          </div>
          <div>
            <label for="message" class="font-mono-label text-slate\/50" style="display: block; margin-bottom: 0.5rem;">Message</label>
            <textarea id="message" name="message" class="field" required rows="5" placeholder="How can we help?"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="margin-top: 0.5rem;">
            Send message
            <Icon name="arrowRight" class="w-4 h-4" decorative />
          </button>
          <p id="form-status" style="font-size: 0.875rem; color: var(--sage-600); display: none;"></p>
        </form>
      </div>

      <div class="mt-10 reveal" style="text-align: center;">
        <p class="font-mono-label text-slate\/40 mb-2">Or email us directly</p>
        <a href="mailto:hello@annai.sg" style="font-size: 1.1rem; font-weight: 600; color: var(--sage-600);">hello@annai.sg</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    status.style.display = 'block';
    status.textContent = 'Sending...';
    try {
      const data = new FormData(form);
      const res = await fetch('/api/contact', {
        method: 'POST',
        body: JSON.stringify(Object.fromEntries(data)),
        headers: { 'Content-Type': 'application/json' },
      });
      if (res.ok) {
        status.textContent = 'Thank you. We will get back to you within one business day.';
        form.reset();
      } else {
        status.textContent = 'Something went wrong. Please email hello@annai.sg directly.';
      }
    } catch {
      status.textContent = 'Something went wrong. Please email hello@annai.sg directly.';
    }
  });
</script>

<style>
  .w-4 { width: 1rem; }
  .h-4 { height: 1rem; }
</style>
