---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Partners — Anna.I"
  description="Become an Anna.I service partner. Join Singapore's coordinated home-services network — vetted vendors, reliable scheduling, guaranteed payment through escrow."
>
  <section class="section">
    <div class="container-content">
      <div class="text-center max-w-2xl mx-auto mb-12 reveal">
        <span class="badge mb-5">For vendors</span>
        <h1 class="text-fluid-3xl mb-4 text-balance">Grow your business. We handle the rest.</h1>
        <p class="text-fluid-lg text-slate\/70 text-pretty">
          Anna.I connects vetted service providers with households that need them.
          No more chasing leads, no-show clients, or payment disputes.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem;">
        <div class="card reveal">
          <Icon name="nodeCluster" class="w-8 h-8 mb-4" />
          <h3 class="text-fluid-xl mb-2">Steady, matched jobs</h3>
          <p class="text-slate\/70 text-pretty">
            Anna.I matches you with households that fit your category, capacity, and schedule.
            No more scrolling listings or competing on price alone.
          </p>
        </div>
        <div class="card reveal">
          <Icon name="shieldLock" class="w-8 h-8 mb-4" />
          <h3 class="text-fluid-xl mb-2">Guaranteed payment</h3>
          <p class="text-slate\/70 text-pretty">
            Payment is held in escrow before the job starts and released the moment your
            work is verified complete. No chasing, no disputes, no bad debt.
          </p>
        </div>
        <div class="card reveal">
          <Icon name="fingerprint" class="w-8 h-8 mb-4" />
          <h3 class="text-fluid-xl mb-2">Build your reputation</h3>
          <p class="text-slate\/70 text-pretty">
            Your performance is tracked over time — not just one-off star ratings.
            Great work compounds into more jobs at better rates.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Join the network"
    headline="Become an Anna.I partner."
    body="Apply once. We verify your background, identity, and track record. From there, jobs come to you."
    primaryLabel="Register Now"
    secondaryLabel="See how it works"
    secondaryHref="/#how-it-works"
  />
</BaseLayout>

<style>
  .w-8 { width: 2rem; }
  .h-8 { height: 2rem; }
  @media (min-width: 768px) {
    section > div > div:last-child { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (min-width: 1024px) {
    section > div > div:last-child { grid-template-columns: repeat(3, 1fr) !important; }
  }
</style>
