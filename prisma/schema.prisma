// ============================================================
// Anna.I — Household Graph Schema (Phase 1)
// PostgreSQL (production) / SQLite (local sandbox)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ======================== ENUMS ========================

enum ServiceCategory {
  CLEANING
  LAUNDRY
  AIRCON
  PLUMBING
  ELECTRICAL
  PAINTING
  PEST_CONTROL
  HANDYMAN
  LOCKSMITH
  APPLIANCE_REPAIR
}

enum TaskStatus {
  CREATED
  PREDICTED
  MATCHING
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  ESCROW_RELEASED
  DISPUTED
  DISPUTE_CLOSED
  CANCELLED
}

enum EscrowState {
  HELD
  RELEASED
  DISPUTED
  DISPUTE_CLOSED
  REFUNDED
}

enum SubscriptionTier {
  HOME
  CARE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum VendorType {
  MICRO
  SME
}

enum MemberRole {
  OWNER
  MEMBER
}

enum PropertyType {
  HDB
  CONDOMINIUM
  LANDED
  OFFICE
  OTHER
}

enum AddressOwner {
  HOUSEHOLD
  VENDOR
}

enum NotificationChannel {
  WHATSAPP
  WEB_PUSH
  EMAIL
}

enum NotificationEventType {
  TASK_CREATED
  TASK_DISPATCHED
  VENDOR_EN_ROUTE
  VERIFICATION_REQUESTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  ESCROW_RELEASED
  DISPUTE_RAISED
  DISPUTE_RESOLVED
  REBOOKING_PROMPT
  AUTONOMY_PROMOTED
  PREDICTIVE_SUGGESTION
  SYSTEM_ALERT
  ANOMALY_VENDOR_LATE
  ANOMALY_TASK_OVERDUE
  ANOMALY_VERIFICATION_MISSING
  ANOMALY_RATING_DROP
  ANOMALY_ESCROW_DISPUTED
  VENDOR_MATCHED
  VENDOR_ACCEPTED
  VENDOR_SCHEDULED
  VENDOR_REJECTED
  ADDON_REQUESTED
  ADDON_APPROVED
  ADDON_REJECTED
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum AnomalyType {
  VENDOR_LATE
  TASK_OVERDUE
  VERIFICATION_MISSING
  RATING_DROP
  ESCROW_DISPUTED
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnomalyStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum RecipientType {
  HOUSEHOLD_MEMBER
  VENDOR
}

enum QuotationStatus {
  DRAFT
  ACCEPTED
  REJECTED
}

// ======================== CORE TABLES ========================

model Household {
  id                    String    @id @default(cuid())
  name                  String // Household name (e.g. "Tan Family")
  fullName              String? // Primary contact person's full name (e.g. "Alex Tan")
  email                 String    @unique
  phone                 String? // Singapore mobile (+65XXXXXXXX, 8 digits starting 8/9)
  address               String // estate-level for batching (denormalised from default Address)
  postalCode            String?
  unitNumber            String?
  activeCategories      String // JSON array of ServiceCategory — SQLite can't do enum[]; Postgres = JSONB or native[]
  preferences           Json // flexible: language, preferred times, notes
  onboardingProfile     Json? // Deep household intelligence: homeType, occupants, lifestyle, painPoints, serviceHabits, autonomyPreference
  onboardingStep        Int       @default(0) // 0=not started, 1-9 steps
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // ── Marketing: acquisition tracking ──
  acquisitionSource     AcquisitionSource @default(ORGANIC) // pilot_cohort | public_code | partnership_referral | organic | other
  acquisitionCampaignId String? // FK to Campaign (nullable — organic has no campaign)

  members          FamilyMember[]
  tasks            Task[]
  subscriptions    Subscription[]
  categoryAutonomy HouseholdCategoryAutonomy[]
  vendorAffinity   VendorHouseholdAffinity[]
  notifications    Notification[]
  anomalies        Anomaly[]
  quotations       Quotation[]
  addresses        Address[]
}

model FamilyMember {
  id           String     @id @default(cuid())
  householdId  String
  name         String
  email        String     @unique
  phone        String?
  avatarUrl    String? // relative path e.g. /avatars/xxx.jpg
  role         MemberRole @default(MEMBER)
  passwordHash String? // household portal login (null = ops-managed, no self-serve access)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  household      Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  notifications  Notification[]
  approvedAddons BookingAddon[] @relation("AddonApprover")
}

model Vendor {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  phone             String
  contactPerson     String? // Name of primary contact person (Contact Person 1)
  contactEmail1     String? // Contact Person 1 email
  contactPhone1     String? // Contact Person 1 phone
  contactPerson2    String? // Secondary contact person
  contactEmail2     String? // Contact Person 2 email
  contactPhone2     String? // Contact Person 2 phone
  companyName       String? // Registered company name (e.g. "FreshWash Pte Ltd")
  companyRegNo      String? // ACRA / UEN registration number
  registeredAddress String? // Registered office address (free-text)
  categories        String // JSON array of ServiceCategory
  status            VendorStatus @default(PENDING)
  vendorType        VendorType   @default(MICRO)
  staffCount        Int          @default(1)
  dailyCapacity     Int          @default(6)
  verificationData  Json? // NRIC, background check, certs
  maxTasksPerDay    Int          @default(6)
  maxTasksPerWeek   Int          @default(30)
  availability      Json? // working hours, days off
  zones             String // JSON array of estate zone strings
  avatarUrl         String? // relative path e.g. /avatars/vendors/xxx.jpg
  passwordHash      String? // vendor portal login (null = ops-managed, no self-serve access)
  roleId            String? // FK → Role (vendor RBAC)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  bookings         Booking[]
  staff            VendorStaff[]
  vendorUsers      VendorUser[]
  vendorAffinity   VendorHouseholdAffinity[]
  vendorPlan       VendorPlan?
  featureOverrides VendorFeatureOverride[]
  notifications    Notification[]
  addresses        Address[]
  createdAddons    BookingAddon[]            @relation("AddonCreator")
  roleRel          Role?                     @relation("VendorRole", fields: [roleId], references: [id])
  auditLogs        AuditLog[]
}

// ======================== ADDRESSES ========================

model Address {
  id            String       @id @default(cuid())
  ownerType     AddressOwner
  ownerId       String // Denormalised owner reference for polymorphic queries
  householdId   String? // FK → Household.id (populated when ownerType = HOUSEHOLD)
  vendorId      String? // FK → Vendor.id (populated when ownerType = VENDOR)
  label         String? // "Home", "Office", "Parents' House" etc.
  propertyType  PropertyType @default(HDB)
  postalCode    String // Singapore 6-digit postal code
  blockNumber   String? // HDB / Condominium
  streetName    String? // auto-populated from postal lookup or manual
  buildingName  String? // Condominium / Office (e.g. "Marina Bay Sands")
  level         String? // HDB / Condominium / Office
  unitNumber    String? // HDB / Condominium / Office
  houseNumber   String? // Landed Property
  streetAddress String? // Landed / Office: full street line (e.g. "Orchard Road")
  fullAddress   String // Computed human-readable address string
  isDefault     Boolean      @default(false)
  latitude      Float? // Future: GPS coordinates
  longitude     Float? // Future: GPS coordinates
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendor    Vendor?    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([ownerType, ownerId])
  @@index([ownerType, ownerId, isDefault])
  @@index([postalCode])
  @@index([householdId])
  @@index([vendorId])
}

// ======================== MEMORY ========================

model VendorHouseholdAffinity {
  id                String          @id @default(cuid())
  householdId       String
  vendorId          String
  category          ServiceCategory
  bookingCount      Int             @default(0)
  completedCount    Int             @default(0)
  totalRating       Float           @default(0) // sum; divide by completedCount for avg
  avgRating         Float? // denormalized for query speed
  reassignmentCount Int             @default(0)
  disputeCount      Int             @default(0)
  jobOutcomes       Json? // last N outcomes array
  lastAssignedAt    DateTime?
  lastCompletedAt   DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([householdId, vendorId, category])
}

// ======================== TASKS & BOOKINGS ========================

model Task {
  id                 String          @id @default(cuid())
  householdId        String
  category           ServiceCategory
  status             TaskStatus      @default(CREATED)
  jobTypeId          String?
  quotationId        String?         @unique
  recurrencePattern  Json? // {type, interval, dayOfWeek} — null = one-off
  instructions       String?
  instructionsSource String? // "new" | "reused" | "modified" — Seed metric
  amountCents        Int // SGD cents (blended avg ~6800)
  discountCents      Int      @default(0) // Phase 3: discount applied from promo code
  discountCodeId     String?  // Phase 3: FK to DiscountCode (nullable — no code used)
  finalAmountCents   Int      @default(0) // Phase 3: amountCents - discountCents (set on creation)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  dispatchedAt       DateTime?
  acceptedAt         DateTime? // Phase 8: vendor accepted → task ACCEPTED
  scheduledAt        DateTime? // Phase 8: task scheduled → task SCHEDULED
  inProgressAt       DateTime?
  completedAt        DateTime?
  verifiedAt         DateTime?
  escrowReleasedAt   DateTime?
  disputedAt         DateTime?
  scheduledStart     DateTime?
  metadata           Json? // { autoDispatched, autoMatched, autoVerified, autoEscrowReleased, matchAttempts, currentMatchVendorId }
  acceptTimeoutAt    DateTime? // Phase 8: vendor acceptance deadline — auto-cancel if not accepted by this time
  lockAt             DateTime? // Phase 4: Predictive — deadline before which household can cancel/edit
  cancelledAt        DateTime? // Phase 4: Predictive — when household cancelled this prediction
  cancelReason       String? // Phase 4: Predictive — household's cancel reason

  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  jobType            ServiceJobType?     @relation(fields: [jobTypeId], references: [id])
  quotation          Quotation?          @relation(fields: [quotationId], references: [id])
  bookings           Booking[]
  verificationPhotos VerificationPhoto[]
  escrowEntries      EscrowLedger[]
  attachments        TaskAttachment[]
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  fileType     String // "PHOTO" | "VIDEO"
  fileUrl      String
  thumbnailUrl String?
  fileSize     Int // bytes
  fileName     String
  mimeType     String
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Booking {
  id              String    @id @default(cuid())
  taskId          String
  vendorId        String
  assignedStaffId String? // SME: which vendor_staff is assigned
  scheduledStart  DateTime
  scheduledEnd    DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  rating          Int? // 1–5
  ratingComment   String?
  completionNotes String? // Vendor's work summary, recommendations, feedback (e.g. "Recommend chemical wash next time")
  status          String    @default("assigned") // assigned|accepted|in_progress|completed|cancelled
  dispatchedAt    DateTime  @default(now())
  acceptedAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  shareToken      String?   @unique // SME: shareable link for assigned staff
  sharedAt        DateTime? // when share token was generated
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  task               Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  vendor             Vendor              @relation(fields: [vendorId], references: [id])
  assignedStaff      VendorStaff?        @relation(fields: [assignedStaffId], references: [id])
  verificationPhotos VerificationPhoto[]
  escrowEntries      EscrowLedger[]
  addons             BookingAddon[]
}

// ======================== VERIFICATION ========================

model VerificationPhoto {
  id              String    @id @default(cuid())
  taskId          String
  bookingId       String
  fileUrl         String
  thumbnailUrl    String?
  uploadedBy      String // "vendor:before" | "vendor:after" | "staff:before" | "staff:after"
  isVerified      Boolean   @default(false)
  verifiedBy      String? // memberId who verified
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id])
}

// ======================== AD-HOC CHARGES ========================
// Staff/vendor can add additional charges during a job (e.g., gas top-up).
// The user (household) receives a notification and must approve before work proceeds.

model BookingAddon {
  id           String    @id @default(cuid())
  bookingId    String
  description  String // e.g., "Gas top-up for air-con unit"
  amountCents  Int // additional charge in cents
  status       String    @default("pending") // pending | approved | rejected
  addedById    String? // vendorId who added the charge
  approvedById String? // memberId who approved/rejected
  approvedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addedBy    Vendor?       @relation("AddonCreator", fields: [addedById], references: [id])
  approvedBy FamilyMember? @relation("AddonApprover", fields: [approvedById], references: [id])
}

// ======================== ESCROW ========================

model EscrowLedger {
  id                    String      @id @default(cuid())
  taskId                String
  bookingId             String?
  amountCents           Int
  state                 EscrowState @default(HELD)
  commissionRate        Float       @default(10.0)
  commissionCents       Int
  vendorPayoutCents     Int
  refundCents           Int         @default(0) // cumulative amount refunded (partial refunds)
  stripePaymentIntentId String?
  stripeTransferId      String?
  createdAt             DateTime    @default(now())
  heldAt                DateTime    @default(now())
  releasedAt            DateTime?
  disputedAt            DateTime?
  refundedAt            DateTime?
  disputeReason         String?
  disputeResolution     String?
  disputeResolvedBy     String?
  disputeResolvedAt     DateTime?

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  @@index([taskId])
  @@index([state])
}

// ======================== REFUND (audit trail for each refund event) ========================
// One row per refund event (supports multiple partial refunds on the same escrow).
// When Stripe is integrated, stripeRefundId + stripeStatus will be populated
// by the PaymentService implementation (see src/lib/payments/).

model Refund {
  id             String   @id @default(cuid())
  escrowLedgerId String
  amountCents    Int // amount refunded in THIS event (not cumulative)
  reason         String
  issuedById     String? // ops user ID who authorised the refund
  issuedByName   String
  idempotencyKey String // client-supplied idempotency key (unique → prevents duplicate refunds)
  stripeRefundId String? // populated by PaymentService when Stripe is integrated
  stripeStatus   String? // pending | succeeded | failed (Stripe lifecycle)
  createdAt      DateTime @default(now())

  escrowLedger EscrowLedger @relation(fields: [escrowLedgerId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([escrowLedgerId])
  @@index([createdAt])
}

// ======================== SUBSCRIPTION ========================

model Subscription {
  id                   String             @id @default(cuid())
  householdId          String
  tier                 SubscriptionTier   @default(HOME)
  status               SubscriptionStatus @default(ACTIVE)
  priceCents           Int                @default(800) // Home = SGD $8/mo
  stripeSubscriptionId String?
  billingCycleStart    DateTime           @default(now())
  billingCycleEnd      DateTime?
  nextBillingDate      DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

// ======================== AUTONOMY LADDER ========================

model AutonomyLevelThreshold {
  id             String          @id @default(cuid())
  category       ServiceCategory
  level          Int // 1–5
  cyclesRequired Int // verified bookings to promote

  @@unique([category, level])
}

model HouseholdCategoryAutonomy {
  id                    String          @id @default(cuid())
  householdId           String
  category              ServiceCategory
  currentLevel          Int             @default(1) // 1–5
  verifiedCyclesAtLevel Int             @default(0)
  totalVerifiedCycles   Int             @default(0)
  promotionPaused       Boolean         @default(false)
  lastPromotedAt        DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, category])
}

// ======================== NOTIFICATIONS ========================

model Notification {
  id                String                @id @default(cuid())
  householdId       String
  recipientType     RecipientType
  memberId          String? // FK → FamilyMember (when recipientType = HOUSEHOLD_MEMBER)
  vendorId          String? // FK → Vendor (when recipientType = VENDOR)
  channel           NotificationChannel
  eventType         NotificationEventType
  title             String
  body              String
  status            NotificationStatus    @default(PENDING)
  referenceType     String? // "task" | "booking" | "escrow"
  referenceId       String?
  externalMessageId String? // Twilio SID, Push sub ID, etc.
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime              @default(now())

  household Household     @relation(fields: [householdId], references: [id])
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull) // C-3 FIX: allow member deletion
  vendor    Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
}

// ======================== SERVICE JOB TYPES & QUOTATION (Phase 4A) ========================

model ServiceJobType {
  id             String          @id @default(cuid())
  category       ServiceCategory
  name           String
  slug           String          @unique
  description    String // short one-liner shown on card
  basePriceCents Int // base price in SGD cents
  unitLabel      String // "per unit", "flat rate", "per room"
  pricingRules   Json // { type, unitField?, areaMultiplier? }
  requiredFields Json // array of field definitions
  addOns         Json // array of { key, label, priceCents }
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  quotations Quotation[]
  tasks      Task[]

  @@index([category, isActive, sortOrder])
}

model Quotation {
  id             String          @id @default(cuid())
  householdId    String
  jobTypeId      String
  fieldValues    Json // user's answers to dynamic fields
  selectedAddOns Json // array of add-on keys selected
  baseCents      Int
  addOnsCents    Int             @default(0)
  totalCents     Int
  breakdown      Json // line items: [{ label, amountCents }]
  aiExplanation  String? // Phase B: LLM-generated explanation
  status         QuotationStatus @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  household Household      @relation(fields: [householdId], references: [id])
  jobType   ServiceJobType @relation(fields: [jobTypeId], references: [id])
  task      Task?

  @@index([householdId])
  @@index([jobTypeId])
}

// ======================== VENDOR FIELD ROSTER (Staff Roster) ========================
// Front-end operations team — field workers assigned to bookings.
// These CANNOT log in to the vendor portal. Managed via Staff Roster UI
// and by Ops coordinators. Each vendor (especially SME) has a roster of
// cleaners / technicians / handymen who carry out jobs in the field.
// RBAC roles do NOT apply to roster members.

model VendorStaff {
  id        String   @id @default(cuid())
  vendorId  String
  name      String
  contact   String // phone or email (display / contact only)
  jobTitle  String? // e.g. "Cleaner", "Aircon Technician", "Handyman"
  role      String   @default("staff") // legacy free-text label (staff | lead | supervisor)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([vendorId])
  @@index([isActive])
}

// ======================== VENDOR USER (HQ Staff — User Management) ========================
// Back-office / HQ staff who log into the vendor portal: finance, auditors,
// analysts, operations managers, etc. These are NOT field workers — they
// do not appear on the Staff Roster and are not assignable to bookings.
// Authenticated via POST /api/vendor/auth (email + passwordHash).
// RBAC roles apply (roleId FK → Role).

model VendorUser {
  id           String   @id @default(cuid())
  vendorId     String
  name         String
  email        String // login email (unique globally — one identity across vendors)
  contact      String // phone (display)
  jobTitle     String? // e.g. "Finance Manager", "Auditor", "Operations Analyst"
  role         String   @default("staff") // legacy free-text label
  roleId       String? // FK → Role (vendor RBAC)
  passwordHash String // bcrypt hash — required (HQ users always have login)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor  Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  roleRel Role?  @relation("VendorUserRole", fields: [roleId], references: [id])

  @@unique([email])
  @@index([vendorId])
  @@index([isActive])
}

// ======================== VENDOR ENTITLEMENT & PLANS ========================
// Data model only — no SME/Enterprise-tier UI until post-pilot.
// Use hasFeature(vendorId, featureKey) for all feature checks.

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique // Micro | SME | Enterprise
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendorPlans  VendorPlan[]  @relation("VendorPlanPlan")
  planFeatures PlanFeature[]
}

model Feature {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. team_management, advanced_analytics, multi_branch, api_access, custom_automation
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planFeatures    PlanFeature[]
  vendorOverrides VendorFeatureOverride[]
}

model PlanFeature {
  id        String @id @default(cuid())
  planId    String
  featureId String

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
}

model VendorPlan {
  id            String   @id @default(cuid())
  vendorId      String   @unique
  planId        String
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])
  plan   Plan   @relation("VendorPlanPlan", fields: [planId], references: [id])
}

model VendorFeatureOverride {
  id        String  @id @default(cuid())
  vendorId  String
  featureId String
  enabled   Boolean @default(true)

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([vendorId, featureId])
}

// ======================== ANOMALY DETECTION (Phase 3) ========================

model Anomaly {
  id             String          @id @default(cuid())
  householdId    String
  taskId         String?
  bookingId      String?
  vendorId       String?
  type           AnomalyType
  severity       AnomalySeverity @default(MEDIUM)
  message        String // human-readable description
  metadata       Json? // extra context: { scheduledStart, slaMinutes, currentRating, avgRating, ... }
  status         AnomalyStatus   @default(ACTIVE)
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, status])
  @@index([type, status])
  @@index([severity])
}

// ======================== PASSWORD RESET ========================

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  userType  String    @default("household") // "household" | "vendor" | "ops"
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, userType])
}

// ======================== OPS AUTH & AUDIT ========================

enum OpsRole {
  ADMIN
  COORDINATOR
  ANALYST
}

// ======================== RBAC MODELS ========================

model Role {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  level       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           OpsUser[]
  vendors         Vendor[]         @relation("VendorRole")
  vendorUsers     VendorUser[]     @relation("VendorUserRole")
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  description String   @default("")
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OpsUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  role         OpsRole   @default(COORDINATOR)
  roleId       String?
  isActive     Boolean   @default(true)
  updatedBy    String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  lastLoginAt  DateTime?

  roleRel   Role?      @relation(fields: [roleId], references: [id])
  auditLogs AuditLog[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String? // FK → OpsUser (nullable so vendor-scope actions can be logged)
  userName   String
  vendorId   String? // FK → Vendor (set when the actor is a vendor/vendor-user, not an OpsUser)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user   OpsUser? @relation(fields: [userId], references: [id])
  vendor Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([vendorId])
  @@index([createdAt])
}

// ======================== MARKETING MODULE ========================
// Campaign engine for discount-driven campaigns: first-time offers,
// upgrade discounts, cross-sell nudges, public promo codes, referrals.
// Lives inside the Ops CMS on the shared schema.

// ── Enums ──

enum CampaignType {
  FIRST_TIME
  CROSS_SELL
  UPGRADE
  REFERRAL
  PUBLIC_PROMO
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum CampaignAppliesTo {
  SUBSCRIPTION_FEE
  JOB_COMMISSION
  BOTH
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountEligibility {
  FIRST_TIME_HOUSEHOLD_ONLY
  EXISTING_HOUSEHOLD
  ANY
}

enum AcquisitionSource {
  PILOT_COHORT
  PUBLIC_CODE
  PARTNERSHIP_REFERRAL
  ORGANIC
  OTHER
}

// ── Campaign ──

model Campaign {
  id               String            @id @default(cuid())
  name             String
  description      String?
  type             CampaignType
  status           CampaignStatus    @default(DRAFT)
  startDate        DateTime?
  endDate          DateTime?
  appliesTo        CampaignAppliesTo @default(BOTH)
  targetTier       String? // "HOME" | "CARE" | null = all
  targetCategory   String? // ServiceCategory or null = all
  maxRedemptions   Int? // campaign-level cap (null = unlimited)
  redemptionsCount Int               @default(0) // running total
  createdById      String?
  createdByName    String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  discountRule DiscountRule?
  codes        DiscountCode[]
  redemptions  CodeRedemption[]

  @@index([status])
  @@index([type])
}

// ── DiscountRule (one per campaign, versioned via updatedAt) ──

model DiscountRule {
  id                  String              @id @default(cuid())
  campaignId          String              @unique
  discountType        DiscountType
  discountValue       Float // 20 = $20 or 15 = 15%
  minOrderValueCents  Int? // minimum job/subscription value
  maxDiscountCapCents Int? // ceiling for percentage (e.g. $30 cap)
  stackable           Boolean             @default(false)
  eligibility         DiscountEligibility @default(ANY)
  minAutonomyLevel    Int?
  maxAutonomyLevel    Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ── DiscountCode ──

model DiscountCode {
  id            String    @id @default(cuid())
  code          String    @unique // uppercase, indexed
  campaignId    String
  batchId       String? // groups codes generated together
  maxUses       Int? // null = unlimited (within campaign constraints)
  usesRemaining Int? // decremented on redemption (null = unlimited)
  expiresAt     DateTime?
  isActive      Boolean   @default(true) // manual kill-switch
  createdAt     DateTime  @default(now())

  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  redemptions CodeRedemption[]

  @@index([campaignId])
  @@index([batchId])
  @@index([isActive])
}

// ── CodeRedemption (audit trail) ──

model CodeRedemption {
  id                   String   @id @default(cuid())
  discountCodeId       String
  campaignId           String
  householdId          String
  bookingId            String? // the job the discount applied to (if job_commission)
  subscriptionId       String? // the subscription event (if subscription_fee)
  discountAppliedCents Int // actual $ value discounted, for reconciliation
  redeemedAt           DateTime @default(now())

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([discountCodeId])
  @@index([householdId])
  @@index([campaignId])
}

// ======================== PLATFORM CONFIG ========================

model PlatformConfig {
  key       String   @id // e.g. "commission_rate", "category_price_CLEANING"
  value     String // JSON or numeric string
  label     String // human-readable description
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}
